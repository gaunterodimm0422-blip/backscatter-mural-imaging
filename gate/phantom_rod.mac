# Transverse line-spread target: a concrete cylinder along global y.
# TARGET_RADIUS_MM is half the rod width; TARGET_LATERAL_MM is its length.

/gate/world/daughters/name target
/gate/world/daughters/insert cylinder
/gate/target/geometry/setRmin 0 mm
/gate/target/geometry/setRmax {TARGET_RADIUS_MM} mm
/gate/target/geometry/setHeight {TARGET_LATERAL_MM} mm
/gate/target/setMaterial {TARGET_MATERIAL}
/gate/target/placement/setRotationAxis 1 0 0
/gate/target/placement/setRotationAngle 90 deg
/gate/target/placement/setTranslation 0 0 -{TARGET_DEPTH_MM} mm
/gate/target/vis/forceSolid
/gate/target/vis/setColor yellow
/gate/target/attachPhantomSD
