!/outputs/framework_sim_p2.png
!/outputs/framework_sim_p3.png
!/outputs/framework_sim_p4.png
!/outputs/framework_sim_paper.pdf
!/outputs/calib_fit.json
!/outputs/m3v2_predict.json

# Root deliverables are retained; nested historical export bundles are local.
/deliverables/*/

